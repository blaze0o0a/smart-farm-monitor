# 🌱 Smart Farm Monitoring System - 환경 변수 설정
# 이 파일을 복사해서 .env.local로 이름을 변경하고 실제 값으로 수정하세요.
# cp env.local.example .env.local

# ================================
# 📊 MariaDB 데이터베이스 연결 정보
# ================================
# MariaDB 서버 주소 (로컬: localhost, 원격: IP 주소)
DB_HOST=localhost

# MariaDB 포트 (기본값: 3306)
DB_PORT=3306

# 데이터베이스 이름
DB_NAME=smart_farm

# 데이터베이스 사용자명
DB_USER=smart_farm_user

# 데이터베이스 비밀번호 (실제 비밀번호로 변경하세요!)
DB_PASSWORD=your_password_here

# ================================
# 🔧 센서 연결 설정
# ================================
# 실제 센서 사용 여부 (true: 실제 센서, false: 시뮬레이터)
USE_REAL_SENSOR=false

# 센서 연결 포트 (시리얼 포트 경로)
# Linux/Mac: /dev/ttyUSB0, /dev/ttyACM0
# Windows: COM1, COM2, COM3 등
SENSOR_PORT=/dev/ttyUSB0

# 시리얼 통신 속도 (일반적으로 9600 또는 115200)
SENSOR_BAUDRATE=9600

# 센서 데이터 수집 간격 (밀리초, 기본값: 60000 = 1분)
SENSOR_INTERVAL=60000

# ================================
# 🌐 HTTP API 센서 설정 (선택사항)
# ================================
# HTTP API 기반 센서 사용 시
# SENSOR_API_URL=http://192.168.1.100/api/sensors
# SENSOR_API_KEY=your_api_key_here

# ================================
# 📡 MQTT 센서 설정 (선택사항)
# ================================
# MQTT 브로커 설정
# MQTT_BROKER=mqtt://localhost:1883
# MQTT_USERNAME=your_mqtt_user
# MQTT_PASSWORD=your_mqtt_password
# MQTT_TOPIC=smart_farm/sensors

# ================================
# 🚀 애플리케이션 설정
# ================================
# 환경 모드 (development, production)
NODE_ENV=development

# 서버 포트 (기본값: 3331)
PORT=3331

# 로그 레벨 (debug, info, warn, error)
LOG_LEVEL=info

# ================================
# 🔒 보안 설정 (프로덕션 환경)
# ================================
# JWT 시크릿 키 (사용자 인증 기능 추가 시)
# JWT_SECRET=your_jwt_secret_here

# CORS 허용 도메인 (프로덕션에서 특정 도메인만 허용)
# CORS_ORIGIN=https://yourdomain.com
